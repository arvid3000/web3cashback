<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web3Cashback — Earn crypto cashback on every bet, trade and transaction</title>
  <meta name="description" content="Web3Cashback connects you to the top crypto platforms and pays you back every time you play or trade. Real revenue share, paid in USDC.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            background: 'hsl(210,20%,98%)',
            foreground: 'hsl(220,26%,12%)',
            card: '#ffffff',
            border: 'hsl(220,13%,91%)',
            primary: 'hsl(217,91%,60%)',
            'primary-foreground': '#ffffff',
            muted: 'hsl(220,13%,91%)',
            'muted-foreground': 'hsl(220,9%,46%)',
            'tier-bronze': 'hsl(33,60%,50%)',
            'tier-silver': 'hsl(218,11%,65%)',
            'tier-gold': 'hsl(38,92%,50%)',
            'tier-platinum': 'hsl(263,83%,58%)',
          },
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: hsl(210,20%,98%); color: hsl(220,26%,12%); }
    .text-gradient {
      background: linear-gradient(135deg, hsl(217,91%,60%) 0%, hsl(263,83%,58%) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .container { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    details[open] .chevron { transform: rotate(180deg); }
    .chevron { transition: transform 0.2s; }
    .card-casino { border-top: 3px solid hsl(252,95%,85%); }
    .card-exchange { border-top: 3px solid hsl(213,94%,78%); }
    .card-defi { border-top: 3px solid hsl(142,71%,73%); }
    .card-wallet { border-top: 3px solid hsl(186,94%,69%); }
    .badge-casino { background: hsl(250,100%,95%); color: hsl(263,83%,58%); border: 1px solid hsl(252,95%,85%); }
    .badge-exchange { background: hsl(214,95%,93%); color: hsl(217,91%,40%); border: 1px solid hsl(213,94%,78%); }
    .badge-defi { background: hsl(139,76%,93%); color: hsl(142,72%,30%); border: 1px solid hsl(142,71%,73%); }
    .badge-wallet { background: hsl(183,100%,90%); color: hsl(192,91%,30%); border: 1px solid hsl(186,94%,69%); }
  </style>
</head>
<body class="min-h-screen flex flex-col">

