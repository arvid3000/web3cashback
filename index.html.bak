    <!-- WHY WEB3CASHBACK / LOYALTY -->
    <section class="border-b" style="border-color: hsl(220,13%,91%); background: #fff;">
      <div class="container py-16 md:py-24">
        <div class="text-center mb-14">
          <p class="text-sm font-semibold uppercase tracking-widest mb-3" style="color: hsl(217,91%,60%);">Why Web3Cashback</p>
